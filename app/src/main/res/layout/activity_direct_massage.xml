<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/direct_message"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.DirectMessage">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                tools:context=".QRGenerateActivity">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/rectangle"
                    android:layout_margin="15dp">

                    <ImageView
                        android:id="@+id/qrImageView"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:padding="10dp"
                        android:background="@drawable/ic_qr_code"
                        android:contentDescription="todo" />


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:background="@drawable/rectangle"
                android:layout_margin="15dp">

                <com.rilixtech.widget.countrycodepicker.CountryCodePicker
                    android:id="@+id/countryCode"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:layout_marginStart="10dp"
                    app:ccp_textColor="@color/material_dynamic_neutral60"
                    app:ccp_countryPreference="IN"
                    app:ccp_defaultNameCode="IN"
                    app:ccp_textSize="22dp"
                    app:ccp_enablePhoneAutoFormatter="false" />

                <EditText
                    android:id="@+id/phone_number_edt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/normal"
                    android:hint="@string/phone"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:textSize="22dp"
                    android:maxLength="10"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/rectangle"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="230dp"
                    android:layout_height="150dp"
                    android:layout_gravity="start"
                    tools:layout_editor_absoluteX="15dp">

                    <EditText
                        android:id="@+id/writeMessage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="monospace"
                        android:layout_margin="5dp"
                        android:gravity="bottom"
                        android:hint="@string/message"
                        android:importantForAutofill="no"
                        android:padding="15dp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="btnAttach"
                    android:background="@drawable/ic_attach"
                    android:layout_marginBottom="15dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:rotation="325"
                    android:padding="10dp"
                    android:layout_gravity="bottom"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:onClick="sendbtn"
                    android:padding="20dp"
                    android:layout_margin="5dp"
                    android:fontFamily="@font/bold"
                    android:backgroundTint="@color/green"
                    android:background="@drawable/ic_send"/>

            </LinearLayout>



            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="2dp"
                        android:text="@string/fastMessage"
                        android:fontFamily="@font/bold"
                        android:textSize="15dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_margin="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:onClick="btnOne"
                            android:text="Hi..."
                            android:fontFamily="@font/medium"
                            android:background="@drawable/rectangle"
                            android:layout_margin="2dp"
                            android:padding="10dp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:onClick="btnTwo"
                            android:text="Call Me!"
                            android:fontFamily="@font/medium"
                            android:background="@drawable/rectangle"
                            android:layout_margin="2dp"
                            android:padding="10dp"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:onClick="btnThree"
                            android:text="What's Up?"
                            android:fontFamily="@font/medium"
                            android:background="@drawable/rectangle"
                            android:layout_margin="2dp"
                            android:padding="10dp"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:onClick="btnFour"
                            android:text="How Are You?"
                            android:fontFamily="@font/medium"
                            android:background="@drawable/rectangle"
                            android:layout_margin="2dp"
                            android:padding="10dp"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_margin="15dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/medium"
                            android:background="@drawable/rectangle"
                            android:padding="10dp"
                            android:id="@+id/nameBtn"
                            android:onClick="nameBtn"
                            android:textAllCaps="false"
                            android:layout_gravity="center"
                            android:layout_margin="2dp"/>


                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/medium"
                        android:background="@drawable/rectangle"
                        android:padding="10dp"
                        android:textSize="16dp"
                        android:id="@+id/generateQrBtn"
                        android:onClick="QRCodeButton"
                        android:text="@string/generate_qr_code"
                        android:textAllCaps="false"
                        android:gravity="center_horizontal"
                        android:layout_gravity="center"
                        android:layout_marginBottom="20dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>